#version 450

// ─── ВХОДНЫЕ ДАННЫЕ (из вершинного шейдера) ────────────────────
layout(location = 0) in vec3 fragColor;
layout(location = 1) in vec3 fragPos;      // мировая позиция фрагмента
layout(location = 2) in vec3 fragNormal;   // мировая нормаль
layout(location = 3) in vec2 fragUV;       // ← ЛР3: UV-координаты

// ─── ВЫХОД ─────────────────────────────────────────────────────
layout(location = 0) out vec4 outColor;

// ─── UNIFORM-БУФЕР (тот же, что и в вершинном) ─────────────────
layout(binding = 0) uniform UBO {
    mat4 mvp;
    mat4 model;

    vec4 camera_pos;
    vec4 light_direction;
    vec4 light_color;
    vec4 ambient_light;

    vec4 albedo;
    vec4 specular;
    vec4 material;   // material.x = shininess (α), material.y = use_texture (ЛР3)
} ubo;

// ─── ТЕКСТУРА (ЛР3) ────────────────────────────────────────────
// sampler2D — это связка «изображение + сэмплер», привязанная
// к binding 1 в дескрипторном наборе. Во фрагментном шейдере
// через texture(albedo_texture, uv) читаем тексель по UV.
layout(binding = 1) uniform sampler2D albedo_texture;

void main() {
    // ============================================================
    // МОДЕЛЬ ОСВЕЩЕНИЯ БЛИНН-ФОНГА
    // ============================================================
    // Из лекции №4 (слайд 29):
    //
    //    C = I · (cosθ · K_d + K_s · (cosφ)^α) + I_a · K_a
    //
    // Разложим по компонентам:
    //   • cosθ   — диффузная составляющая (закон Ламберта)
    //   • cosφ   — зеркальная составляющая через полувектор h
    //   • (·)^α  — «заострение» блика (чем больше α, тем уже блик)
    //   • I_a·K_a — ambient
    //
    // Все векторы нормализуем, потому что интерполяция между
    // вершинами может изменить их длину.
    // ============================================================

    // N — нормаль поверхности в текущем фрагменте.
    vec3 N = normalize(fragNormal);

    // L — вектор от фрагмента К источнику света.
    // Источник направленный, поэтому его направление одинаково
    // для всей сцены. В буфере хранится направление, КУДА светит свет,
    // поэтому берём его с минусом.
    vec3 L = normalize(-ubo.light_direction.xyz);

    // V — вектор от фрагмента К камере.
    vec3 V = normalize(ubo.camera_pos.xyz - fragPos);

    // H — ПОЛУВЕКТОР (halfway vector). Это ключевая идея Блинн-Фонга:
    // вместо того чтобы считать отражённый вектор R и сравнивать его с V,
    // мы берём среднее между L и V. Это быстрее и даёт более
    // правдоподобный блик на плоскостях.
    //   h = (L + V) / |L + V|
    vec3 H = normalize(L + V);

    // === ЛР3: базовый цвет — из текстуры или из UBO ===
    // ubo.material.y — флаг: 1.0 = использовать текстуру, 0.0 = альбедо.
    // Если используем текстуру — читаем тексель по fragUV и берём его RGB
    // как K_d (базовый цвет материала). Иначе — цвет из uniform-буфера.
    vec3 baseColor;
    if (ubo.material.y > 0.5) {
        vec4 texel = texture(albedo_texture, fragUV);
        baseColor = texel.rgb;
    } else {
        baseColor = ubo.albedo.rgb;
    }

    // ── AMBIENT ─────────────────────────────────────────────────
    // Рассеянный свет: I_a · K_a.
    // Из лекции №4 (слайд 25): ambient не имеет направления,
    // просто добавляет базовую освещённость всем поверхностям.
    // ЛР3: вместо ubo.albedo используем baseColor — он либо из текстуры,
    // либо из UBO (в зависимости от флага).
    vec3 ambient = ubo.ambient_light.rgb * baseColor;

    // ── DIFFUSE ─────────────────────────────────────────────────
    // Закон Ламберта: яркость пропорциональна cos(θ),
    // где θ — угол между нормалью N и направлением света L.
    // cos(θ) = dot(N, L). Берём max с 0, чтобы поверхности,
    // обращённые от света, не давали отрицательный вклад.
    // ЛР3: вместо ubo.albedo — baseColor.
    float diff = max(dot(N, L), 0.0);
    vec3 diffuse = ubo.light_color.rgb * diff * baseColor;

    // ── SPECULAR ────────────────────────────────────────────────
    // Блик по Блинн-Фонгу: K_s · (N · H)^α.
    // N·H = cos(φ), где φ — угол между нормалью и полувектором.
    // α (shininess) управляет «остротой» блика:
    //   α маленькое → широкий мягкий блик (резина)
    //   α большое   → узкий яркий блик (металл/пластик)
    float spec = pow(max(dot(N, H), 0.0), ubo.material.x);
    vec3 specular = ubo.light_color.rgb * spec * ubo.specular.rgb;

    // ── ИТОГОВЫЙ ЦВЕТ ───────────────────────────────────────────
    //   C = ambient + diffuse + specular
    vec3 finalColor = ambient + diffuse + specular;

    outColor = vec4(finalColor, 1.0);
}